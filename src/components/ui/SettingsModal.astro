---
---

<button
	type="button"
	id="openSettingsBtn"
	class="settings-fab"
	aria-label="Abrir menú"
	aria-haspopup="dialog"
	title="Configuración"
>
	<svg
		class="settings-icon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="3"></circle>
		<path
			d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
		></path>
	</svg>
</button>

<dialog id="settingsModal" class="settings-dialog" aria-labelledby="settingsModalTitle">
	<div class="settings-modal-content">
		<header class="settings-modal-header">
			<h2 id="settingsModalTitle" class="settings-modal-title">
				Menú
			</h2>
			<button
				type="button"
				id="closeSettingsBtn"
				class="settings-close-btn"
				aria-label="Cerrar ajustes"
			>
				&times;
			</button>
		</header>

		<div class="settings-modal-body">
			<!-- Opción: Auto Select -->
			<div class="settings-option">
				<div class="settings-option-info">
					<span class="settings-option-title">Auto Select (Selección Automática)</span>
					<p class="settings-option-desc">
						Al presionar "Tirar", completa automáticamente todo el proceso (personaje, variante y posición) para cada jugador, y cambia al Equipo 2 al terminar el Equipo 1.
					</p>
				</div>
				<label class="switch-toggle" for="autoSelectSwitch" title="Activar/Desactivar Auto Select">
					<input
						type="checkbox"
						id="autoSelectSwitch"
						role="switch"
						aria-label="Activar selección automática"
					/>
					<span class="switch-slider"></span>
				</label>
			</div>
		</div>

		<footer class="settings-modal-footer">
			<button type="button" id="doneSettingsBtn" class="spin-btn settings-done-btn">
				LISTO
			</button>
		</footer>
	</div>
</dialog>
