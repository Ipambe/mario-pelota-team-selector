---
---

<button
	type="button"
	id="openSettingsBtn"
	class="settings-fab"
	aria-label="Abrir menú"
	aria-haspopup="dialog"
	title="Configuración"
>
	<svg
		class="settings-icon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="3"></circle>
		<path
			d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
		></path>
	</svg>
</button>

<dialog id="settingsModal" class="settings-dialog" aria-labelledby="settingsModalTitle">
	<div class="settings-modal-content">
		<header class="settings-modal-header">
			<h2 id="settingsModalTitle" class="settings-modal-title">
				Configuración
			</h2>
			<button
				type="button"
				id="closeSettingsBtn"
				class="settings-close-btn"
				aria-label="Cerrar ajustes"
			>
				&times;
			</button>
		</header>

		<div class="settings-modal-body">
			<!-- SECCIÓN 1: REGLAS Y PREFERENCIAS -->
			<section class="settings-section" aria-labelledby="rulesSectionTitle">
				<h3 id="rulesSectionTitle" class="settings-section-title">
					Reglas y Preferencias
				</h3>

				<div class="settings-options-list">
					<!-- Opción: Auto Select -->
					<div class="settings-option">
						<div class="settings-option-info">
							<span class="settings-option-title">Auto Select (Selección Automática)</span>
							<p class="settings-option-desc">
								Completa automáticamente todas las etapas (personaje, variante y posición) para cada jugador y equipo.
							</p>
						</div>
						<label class="switch-toggle" for="autoSelectSwitch" title="Activar/Desactivar Auto Select">
							<input
								type="checkbox"
								id="autoSelectSwitch"
								role="switch"
								aria-label="Activar selección automática"
							/>
							<span class="switch-slider"></span>
						</label>
					</div>

					<!-- Opción: Permitir Repetidos en el mismo equipo -->
					<div class="settings-option">
						<div class="settings-option-info">
							<span class="settings-option-title">Repetidos en el Mismo Equipo</span>
							<p class="settings-option-desc">
								Permite que un personaje pueda elegirse más de una vez dentro de un mismo equipo.
							</p>
						</div>
						<label class="switch-toggle" for="allowDuplicatesSwitch" title="Permitir o denegar repetidos en el mismo equipo">
							<input
								type="checkbox"
								id="allowDuplicatesSwitch"
								role="switch"
								aria-label="Permitir repetidos en el mismo equipo"
							/>
							<span class="switch-slider"></span>
						</label>
					</div>

					<!-- Opción: Elegir Color / Variante -->
					<div class="settings-option">
						<div class="settings-option-info">
							<span class="settings-option-title">Elegir Color de Personajes</span>
							<p class="settings-option-desc">
								Tira la ruleta de color para personajes con variantes de color (Guolquinde, Lo ' pato, Cote, etc...).
							</p>
						</div>
						<label class="switch-toggle" for="enableVariantsSwitch" title="Activar o desactivar ruleta de color">
							<input
								type="checkbox"
								id="enableVariantsSwitch"
								role="switch"
								aria-label="Activar ruleta de color"
							/>
							<span class="switch-slider"></span>
						</label>
					</div>
				</div>
			</section>

			<!-- SECCIÓN 2: CAMBIAR MODO DE SELECCIÓN -->
			<section class="settings-section" aria-labelledby="modesSectionTitle">
				<h3 id="modesSectionTitle" class="settings-section-title">
					Cambiar Modo de Selección
				</h3>

				<div class="settings-modes-group" role="radiogroup" aria-labelledby="modesSectionTitle">
					<!-- Modo 1: Alternado (Draft) -->
					<label class="settings-mode-card" for="modeAlternate">
						<input
							type="radio"
							name="selectionMode"
							id="modeAlternate"
							value="alternate"
							class="settings-mode-radio"
						/>
						<div class="settings-mode-content">
							<div class="settings-mode-header">
								<span class="settings-mode-badge draft-badge">DRAFT ALTERNADO</span>
								<span class="settings-mode-name">Por turnos</span>
							</div>
							<p class="settings-mode-desc">
								Un tiro para el Equipo 1, luego un tiro para el Equipo 2, alternando sucesivamente hasta completar ambos equipos.
							</p>
						</div>
					</label>

					<!-- Modo 2: Secuencial -->
					<label class="settings-mode-card" for="modeSequential">
						<input
							type="radio"
							name="selectionMode"
							id="modeSequential"
							value="sequential"
							class="settings-mode-radio"
						/>
						<div class="settings-mode-content">
							<div class="settings-mode-header">
								<span class="settings-mode-badge sequential-badge">DRAFT COMPLETO</span>
								<span class="settings-mode-name">Secuencial</span>
							</div>
							<p class="settings-mode-desc">
								Primero se completan todos los 9 jugadores del Equipo 1, y luego se completan todos los del Equipo 2.
							</p>
						</div>
					</label>

					<!-- Modo 3: Vecinos (Split Izq / Der) -->
					<label class="settings-mode-card" for="modeNeighbors">
						<input
							type="radio"
							name="selectionMode"
							id="modeNeighbors"
							value="neighbors"
							class="settings-mode-radio"
						/>
						<div class="settings-mode-content">
							<div class="settings-mode-header">
								<span class="settings-mode-badge neighbors-badge">2 EN 1</span>
								<span class="settings-mode-name">Izquierda y Derecha</span>
							</div>
							<p class="settings-mode-desc">
								Se entregan los personajes adyacentes al resultante: uno para cada equipo.
							</p>
						</div>
					</label>
				</div>

				<!-- Sub-opción: Asignación de lados para Vecinos -->
				<div class="settings-suboption" id="splitSidesContainer">
					<div class="settings-suboption-info">
						<span class="settings-suboption-title">Asignación de Lados</span>
						<p class="settings-suboption-desc" id="splitSidesDesc">
							Izquierda: Equipo 1 &bull; Derecha: Equipo 2
						</p>
					</div>
					<label class="switch-toggle" for="splitSidesSwitch" title="Alternar asignación de lados">
						<input
							type="checkbox"
							id="splitSidesSwitch"
							role="switch"
							aria-label="Alternar asignación de lados: Izquierda para Equipo 1 o Equipo 2"
						/>
						<span class="switch-slider"></span>
					</label>
				</div>
			</section>
		</div>

		<footer class="settings-modal-footer">
			<button type="button" id="doneSettingsBtn" class="spin-btn settings-done-btn">
				LISTO
			</button>
		</footer>
	</div>
</dialog>
