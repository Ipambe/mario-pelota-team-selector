---
import Controls from '../components/roulette/Controls.astro'
import Roulette from '../components/roulette/Roulette.astro'
import TeamSelector from '../components/roulette/TeamSelector.astro'
import Stadium from '../components/stadium/Stadium.astro'
import SettingsModal from '../components/ui/SettingsModal.astro'
import VersusBanner from '../components/ui/VersusBanner.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout>
	<h1 class="sr-only">Mario Pelota Team Selector - Ruleta de Equipos de Mario Superstar Baseball</h1>
	<SettingsModal />
	<main id="main-content">
		<header class="header">
			<Stadium teamNumber={1} />
			<VersusBanner />
			<Stadium teamNumber={2} />
		</header>

		<section class="char-select" aria-label="Ruleta y selector de personajes">
			<TeamSelector />
			<Roulette />
			<Controls />
		</section>
	</main>

	<footer class="app-footer">
		<p>Mario Pelota Team Selector &bull; Proyecto Fan-Made no oficial.</p>
	</footer>
</Layout>

<script>
	import '../scripts/game-controller';
</script>
